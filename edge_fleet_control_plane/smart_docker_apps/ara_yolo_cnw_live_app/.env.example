# Input: RTSP camera, file, or the bundled SDP listener (UDP 20000).
SOURCE=/workspace/input-h264.sdp
# SOURCE=rtsp://camera-or-relay.example/stream

# Manual runs only. On fleet deploy IEMS injects STREAM_INGEST_URL as
# rtsps://edgemediaingest.pods.icicleai.tapis.io:443/cam-<device_uid>
STREAM_INGEST_URL=rtsps://edgemediaingest.pods.icicleai.tapis.io:443/cam-<device_uid>

MODEL_PATH=/workspace/models/Yolo-cnw.pt
MODEL_HOST_PATH=./models
DEVICE=0
HALF=1
CONFIDENCE=0.25
IOU=0.45
IMAGE_SIZE=640
STREAM_FPS=15
STREAM_BITRATE_KBPS=1800
STREAM_WIDTH=480
STREAM_HEIGHT=320
INPUT_WIDTH=480
INPUT_HEIGHT=320
