# --- Secrets and local configuration ---
# Never commit a populated .env. Copy .env.example and fill it in locally.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
# Local Tapis pod spec with real secrets. Use pod-edgecontrolplane.json (placeholders) in git.
edge_fleet_control_plane/deploy/pod-edgecontrolplane-update.json
edge_fleet_control_plane/deploy/env.production

# --- Model weights and build artifacts ---
# Checkpoints, ONNX graphs, and TensorRT engines are tens to hundreds of MB and
# are distributed through Patra / Hugging Face, not git. Engines are also tied to
# the device and TensorRT version that built them, so they are never portable.
*.pt
*.pth
*.onnx
*.engine
*.plan
*.trt
# Scratch space for local .pt -> ONNX -> .engine conversions.
engine_generation/

# --- Local databases ---
# The control plane writes SQLite here; it holds device, user, and heartbeat data.
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Node (agent/dashboard tooling) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Logs and temp ---
*.log
logs/
tmp/
*.tmp

